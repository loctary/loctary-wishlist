# Required by @module-federation/nextjs-mf to use the local webpack install
NEXT_PRIVATE_LOCAL_WEBPACK=true

# URL where loctary-auth microfrontend is served
NEXT_PUBLIC_AUTH_REMOTE_URL=http://localhost:3001

# Cookie domain for domain-wide auth cookie (e.g. .loctary.com for all subdomains)
NEXT_PUBLIC_COOKIE_DOMAIN=localhost

# Your app's public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
