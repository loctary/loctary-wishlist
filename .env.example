# ---------------------------------------------------------------------------
# loctary-wishlist environment
# Copy to .env.local (gitignored). The server reads the SUPABASE_* + server vars;
# the web app only receives the VITE_* (public, build-time) vars.
# ---------------------------------------------------------------------------

# === apps/server (Hono backend) — SERVER ONLY ==============================

# Supabase. The service-role key MUST never reach the web bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3003
NODE_ENV=development

# Cookie domain shared across subdomains. Must match loctary-auth's COOKIE_DOMAIN
# so this backend can read the session cookies auth sets. ".loctary.com" in prod,
# "localhost" in dev.
COOKIE_DOMAIN=localhost

# Origins allowed to call this backend with credentials (the wishlist frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Default wishlist owner shown on the index page (the admin's auth uuid).
WISHLIST_OWNER_ID=f5171c16-c017-4c45-90f4-9161789425c7

# Cloudflare R2 — same bucket as loctary-auth (avatars/ vs wishlist/ prefix).
# When unset the image-upload routes 503, so missing config is a soft failure.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Shared secret for the manual orphan-image cleanup endpoint
# (POST /wishlist/admin/cleanup-orphan-images, header `Authorization: Bearer …`).
# The Cloudflare scheduled() handler runs the same job nightly without it.
IMAGE_CLEANUP_SECRET=

# === apps/web (TanStack Start frontend) — PUBLIC, build-time ===============

# loctary-auth server proxy (the host calls GET /auth/me, POST /auth/logout).
VITE_AUTH_API_URL=http://localhost:3002

# loctary-auth Module Federation remote. Vite serves remoteEntry.js at the root
# (Modern.js used /static/remoteEntry.js — loctary-auth is now Vite).
VITE_AUTH_REMOTE_NAME=loctary_auth
VITE_AUTH_REMOTE_ENTRY=http://localhost:3001/remoteEntry.js

# This wishlist backend.
VITE_WISHLIST_API_URL=http://localhost:3003

# The wishlist shown on the index page. MUST equal the backend's
# WISHLIST_OWNER_ID — the index renders this user's wishlist (owner sees the
# management view, everyone else the public reservable view).
VITE_WISHLIST_OWNER_ID=

# Parent domain to scope the `mode` color-scheme cookie to, shared with auth and
# across subdomains (e.g. ".loctary.com"). Leave empty for local dev.
VITE_COOKIE_DOMAIN=
